{
  "expo": {
    "name": "CarLog",
    "slug": "carlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28282B",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.romy97.carlog"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28282B",
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenueCatAppleApiKey": "",
      "revenueCatGoogleApiKey": "test_DboGEvKcOFMpBANVogwHNzRbZsr",
      "revenueCatEntitlementId": "premium",
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5be6919f-bdec-40bd-ba99-4f65323c1094"
      }
    }
  }
}
